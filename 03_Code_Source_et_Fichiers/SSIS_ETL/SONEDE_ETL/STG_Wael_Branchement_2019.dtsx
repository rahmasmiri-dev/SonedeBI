                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Spécifie l'expression. Cette version d'expression utilise les identificateurs de traçabilité à la place des noms de colonnes."
                      name="Expression">![ISNULL](#{Package\DFT - Load Branchement 2019\Source Excel.Outputs[Sortie de source Excel].Columns[region]}) &amp;&amp; [TRIM]((DT_WSTR,255)#{Package\DFT - Load Branchement 2019\Source Excel.Outputs[Sortie de source Excel].Columns[region]}) != "" &amp;&amp; [FINDSTRING]([LOWER]((DT_WSTR,255)#{Package\DFT - Load Branchement 2019\Source Excel.Outputs[Sortie de source Excel].Columns[region]}),"ensemble",1) == 0</property>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Spécifie la version claire de l'expression. Cette version d'expression utilise les noms de colonnes."
                      expressionType="Notify"
                      name="FriendlyExpression">!ISNULL(region) &amp;&amp; TRIM((DT_WSTR,255)region) != "" &amp;&amp; FINDSTRING(LOWER((DT_WSTR,255)region),"ensemble",1) == 0</property>
